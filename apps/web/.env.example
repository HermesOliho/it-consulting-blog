# Modèle de configuration. Pour travailler : copier en .env.local (jamais commité).
# Attention : tout ce qui commence par VITE_ est visible par les visiteurs du site.
# On n'y met donc JAMAIS de mot de passe, de clé secrète ou de token.

# Adresse de l'API du backend (par défaut : /api)
VITE_API_URL=/api

# true = utilise de fausses données (développement uniquement, sans backend)
VITE_USE_MOCK=true